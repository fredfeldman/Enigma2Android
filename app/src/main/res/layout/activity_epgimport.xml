<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_epgimport"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:navigationIcon="@drawable/ic_arrow_back">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/epg_import"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/epg_import_status"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_epgimport_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="@string/loading_ellipsis" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_epgimport_run"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/run_epg_import"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_epgimport_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/epg_import_sources"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_epgimport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_epgimport_sources"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_epgimport_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:text="@string/no_epg_import_sources"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_epgimport_save_sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_enabled_sources"
        android:background="@drawable/bg_button"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_margin="12dp"
        android:visibility="gone" />
</LinearLayout>
