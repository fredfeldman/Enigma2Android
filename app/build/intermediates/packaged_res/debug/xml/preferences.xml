<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_category_connection">
        <EditTextPreference
            android:key="pref_host"
            android:title="@string/pref_host_title"
            android:inputType="text"
            android:singleLine="true" />
        <EditTextPreference
            android:key="pref_port"
            android:title="@string/pref_port_title"
            android:inputType="number"
            android:defaultValue="80" />
        <CheckBoxPreference
            android:key="pref_use_https"
            android:title="@string/pref_https_title"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="pref_username"
            android:title="@string/pref_username_title"
            android:inputType="text" />
        <EditTextPreference
            android:key="pref_password"
            android:title="@string/pref_password_title"
            android:inputType="textPassword" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_display">
        <Preference
            android:key="pref_hide_bouquets"
            android:title="@string/pref_hide_bouquets_title" />
        <Preference
            android:key="manage_bouquets"
            android:title="@string/pref_title_edit_bouquets"
            android:summary="@string/pref_summary_edit_bouquets" />
        <CheckBoxPreference
            android:key="pref_night_mode"
            android:title="@string/pref_night_mode_title"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_playback">
        <CheckBoxPreference
            android:key="pref_auto_resume"
            android:title="@string/pref_auto_resume_title"
            android:defaultValue="false" />
        <ListPreference
            android:key="channel_tap_action"
            android:title="@string/pref_channel_tap_action_title"
            android:summary="@string/pref_channel_tap_action_summary"
            android:entries="@array/channel_tap_action_entries"
            android:entryValues="@array/channel_tap_action_values"
            android:defaultValue="stream" />
        <CheckBoxPreference
            android:key="zap_on_player_nav"
            android:title="@string/pref_zap_on_player_nav_title"
            android:summary="@string/pref_zap_on_player_nav_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_receiver">
        <Preference
            android:key="pref_box_info"
            android:title="@string/box_info"
            android:summary="@string/box_info_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_category_plugins"
        android:title="@string/pref_category_plugins">
        <Preference
            android:key="pref_epg_import"
            android:title="@string/epg_import"
            android:summary="@string/epg_import_summary" />
    </PreferenceCategory>

</PreferenceScreen>
